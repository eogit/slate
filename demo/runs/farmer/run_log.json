{
 "question": "I'm a tenant farmer near Ely on 180 ha: 60 ha of potatoes and 40 ha of winter wheat on deep peat, 80 ha of grass, 90 suckler cows with followers and 200 breeding ewes, and a few kilometres of hedges. Where do most of my farm's emissions come from, and what would raising the water table on the potato ground, a methane-reducing feed additive and planting hedgerow trees each do?",
 "persona": "farmer",
 "persona_fixed": true,
 "persona_rationale": "set by the application",
 "clarifications": [],
 "assumptions": [
  {
   "topic": "Location",
   "assumption": "Farm near Ely, Cambridgeshire (about 52.40 N, 0.26 E), on East Anglian Fen deep peat; DT8 Fenland parameters apply to the 100 ha of potatoes and wheat, and the DT6 'fens' pilot tile stands in for the farm's hedgerow-tree growth.",
   "rationale": "Ely sits in the Fens, which DT8 and the DT6 fens pilot cover."
  },
  {
   "topic": "Grassland soil",
   "assumption": "The 80 ha of grass is treated as not on drained deep peat, so no peat-soil CO2/N2O is calculated for it; only the livestock methane is counted.",
   "rationale": "The user said only the potato and wheat ground is deep peat."
  },
  {
   "topic": "Current water table",
   "assumption": "The arable peat is at the DT8 drained Fenland climatology (mean water table about 0.66 m below the surface), with typical Fenland fertiliser rates.",
   "rationale": "No dipwell data given."
  },
  {
   "topic": "Raising the water table",
   "assumption": "Two readings: (a) keep growing potatoes with the mean water table raised to 0.45 m and to 0.30 m; (b) fully rewet the 60 ha to reed paludiculture, with a sweep of water tables (0.05-0.66 m) after an established regime (3 years).",
   "rationale": "'Raising the water table' could mean partial raising under cropping or full rewetting; both are shown."
  },
  {
   "topic": "Herd structure",
   "assumption": "90 suckler cows with followers = 90 beef cows, 2 breeding bulls, 85 calves, 20 breeding heifers, 40 steers and 20 heifers for slaughter; 200 ewes with 5 rams and 300 lambs.",
   "rationale": "Typical suckler herd with about 95% calving and 20% replacement; about 1.5 lambs per ewe. The user did not give follower numbers."
  },
  {
   "topic": "Feed additive",
   "assumption": "Applied to cattle only, as a herd-average enteric reduction of 15% (central: about 30% effect while housed for about half the year) and 30% (upper: effect all year). No additive for grazing sheep.",
   "rationale": "Methane-reducing additives are mainly fed in housed rations; suckler cattle graze much of the year."
  },
  {
   "topic": "Hedgerow trees",
   "assumption": "About 3 km of hedge with one new hedgerow tree every 30 m = 100 trees planted in 2027, followed for 50 years.",
   "rationale": "'A few kilometres' was not quantified."
  },
  {
   "topic": "GWP",
   "assumption": "CO2-equivalents use AR6 GWP100 throughout (DT8 uses AR6; DT2 set to AR6 for consistency).",
   "rationale": "So that the different sources can be added up."
  }
 ],
